# Copy to .env and adjust. Every value is optional; these are the defaults.
QPG_DATA_DIR=data
QPG_OLLAMA_URL=http://localhost:11434
QPG_LLM_MODEL=llama3
QPG_EMBEDDER=st
QPG_EMBED_MODEL=all-MiniLM-L6-v2
QPG_MIN_SIMILARITY=0.35
QPG_MIN_GROUNDING=0.45
QPG_CONTEXT_CHUNKS=3
QPG_FOCUS_RATIO=0.8
QPG_NEIGHBOR_PAGES=8
QPG_CORS_ORIGINS=http://localhost:5173
